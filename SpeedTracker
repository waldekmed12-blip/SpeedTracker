from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.label import Label
from kivy.clock import Clock
from kivy.utils import get_color_from_hex
from plyer import gps, tts
import math

class SpeedTrackerApp(App):
    def build(self):
        self.title = "SpeedTracker"
        
        # Główny układ
        layout = BoxLayout(orientation='vertical', padding=30, spacing=20)
        
        # Etykieta prędkości
        self.speed_label = Label(
            text="0 km/h",
            font_size='72sp',
            bold=True,
            color=get_color_from_hex('#FFFFFF')
        )
        layout.add_widget(self.speed_label)
        
        # Etykieta statusu GPS
        self.status_label = Label(
            text="Inicjalizacja GPS...",
            font_size='18sp',
            color=get_color_from_hex('#AAAAAA')
        )
        layout.add_widget(self.status_label)
        
        # Inicjalizacja GPS
        try:
            gps.configure(on_location=self.on_location, on_status=self.on_status)
            gps.start(minTime=1000, minDistance=1)
            self.status_label.text = "GPS aktywny - szukam sygnału..."
        except NotImplementedError:
            self.status_label.text = "GPS niedostępny na tym urządzeniu."
        
        return layout

    def on_location(self, **kwargs):
        # Pobieramy prędkość (w m/s) i przeliczamy na km/h
        speed_mps = kwargs.get('speed', 0)
        if speed_mps is None:
            speed_mps = 0
        
        speed_kmh = speed_mps * 3.6
        self.speed_label.text = f"{int(speed_kmh)} km/h"
        
        # Przykład ostrzeżenia głosowego przy przekroczeniu np. 50 km/h
        if speed_kmh > 50:
            try:
                tts.speak('Przekroczono dozwoloną prędkość!')
            except Exception:
                pass

    def on_status(self, general_status, status_message):
        self.status_label.text = f"Status: {status_message}"

if __name__ == '__main__':
    SpeedTrackerApp().run()
