import tkinter as tk
import pyttsx3
import threading
import requests
import time
import queue

# Kolejka komunikatów głosowych
komunikaty_queue = queue.Queue()

def watek_glosu():
    engine = pyttsx3.init()
    while True:
        tekst = komunikaty_queue.get()
        if tekst is None:
            break
        print(f"[ALARM GŁOSOWY]: {tekst}")
        try:
            engine.say(tekst)
            engine.runAndWait()
        except Exception as e:
            print(f"Błąd głosu: {e}")
        komunikaty_queue.task_done()

threading.Thread(target=watek_glosu, daemon=True).start()

def powiedz(tekst):
    komunikaty_queue.put(tekst)

class PolskaNawigacjaPredkosci:
    def __init__(self, root):
        self.root = root
        self.root.title("Polska Asystent Prędkości - OpenStreetMap GPS")
        self.root.geometry("380x420")
        self.root.config(bg="#1e1e1e")

        self.uruchomiony = False
        self.aktualne_punkty = 17  
        self.limit_prawny = 50     
        
        self.label_tytul = tk.Label(root, text="ASYSTENT POLSKA", font=("Arial", 14, "bold"), bg="#1e1e1e", fg="#ffffff")
        self.label_tytul.pack(pady=15)

        self.label_status = tk.Label(root, text="STATUS: CZUWANIE", font=("Arial", 11), bg="#1e1e1e", fg="#aaaaaa")
        self.label_status.pack(pady=5)

        self.label_info = tk.Label(root, text="Pobiera aktualne limity z OpenStreetMap\n(uwzględnia zmiany limitów na trasie).", 
                                   font=("Arial", 9), bg="#1e1e1e", fg="#777777", justify="center")
        self.label_info.pack(pady=10)

        self.btn_start = tk.Button(root, text="URUCHOM ASYSTENTA", font=("Arial", 12, "bold"),
                                   bg="#28a745", fg="white", relief="flat", padx=20, pady=12, command=self.przelacz)
        self.btn_start.pack(pady=20)

    def przelacz(self):
        if not self.uruchomiony:
            self.uruchomiony = True
            self.label_status.config(text="STATUS: AKTYWNY (Skanuje mapę)", fg="#28a745")
            self.btn_start.config(text="WYŁĄCZ", bg="#dc3545")
            powiedz("Asystent aktywny. Pobieram dane o prędkościach z mapy Polski.")
            
            threading.Thread(target=self.petla_monitorujaca, daemon=True).start()
        else:
            self.uruchomiony = False
            self.label_status.config(text="STATUS: ZATRZYMANY", fg="#aaaaaa")
            self.btn_start.config(text="URUCHOM ASYSTENTA", bg="#28a745")
            powiedz("Asystent wyłączony.")

    def pobierz_limit_z_openstreetmap(self, lat, lon):
        """Odpytuje OpenStreetMap w promieniu 20 metrów o dokładny znak ograniczenia"""
        try:
            url = f"https://overpass-api.de/api/interpreter?data=[out:json];way(around:20,{lat},{lon})[highway];out;"
            response = requests.get(url, timeout=3)
            if response.status_code == 200:
                data = response.json()
                for element in data.get("elements", []):
                    tags = element.get("tags", {})
                    if "maxspeed" in tags:
                        cyfry = "".join(filter(str.isdigit, tags["maxspeed"]))
                        if cyfry:
                            return int(cyfry)
                    
                    highway_type = tags.get("highway", "")
                    if highway_type == "motorway":
                        return 140
                    elif highway_type in ["trunk", "motorway_link"]:
                        return 120
                    elif highway_type in ["primary", "secondary", "tertiary", "unclassified"]:
                        return 90
                    elif highway_type in ["residential", "living_street", "pedestrian"]:
                        return 50
        except Exception as e:
            print(f"Błąd zapytania do mapy: {e}")
        
        return self.limit_prawny

    def petla_monitorujaca(self):
        trasa_testowa_z_czestymi_zmianami = [
            (51.7592, 19.4559, 75),  
            (51.7612, 19.4600, 75),  
            (51.7635, 19.4650, 85),  
        ]

        while self.uruchomiony:
            for lat, lon, predkosc_gps in trasa_testowa_z_czestymi_zmianami:
                if not self.uruchomiony:
                    break
                
                nowy_limit = self.pobierz_limit_z_openstreetmap(lat, lon)
                if nowy_limit != self.limit_prawny:
                    self.limit_prawny = nowy_limit
                    print(f"[MAPA]: Zmiana limitu na drodze! Nowy limit: {self.limit_prawny} km/h")

                przekroczenie = predkosc_gps - self.limit_prawny

                if przekroczenie > 10:
                    mandat = 0
                    punkty = 0
                    
                    if przekroczenie <= 15:
                        mandat, punkty = 100, 2
                    elif przekroczenie <= 20:
                        mandat, punkty = 200, 3
                    elif przekroczenie <= 25:
                        mandat, punkty = 300, 5
                    elif przekroczenie <= 30:
                        mandat, punkty = 400, 7
                    elif przekroczenie <= 40:
                        mandat, punkty = 800, 9
                    elif przekroczenie <= 50:
                        mandat, punkty = 1000, 11
                    else:
                        mandat, punkty = 2500, 15

                    self.aktualne_punkty += punkty
                    
                    komunikat = f"Uwaga! Ograniczenie do {self.limit_prawny}. Jedziesz {predkosc_gps}. Przekraczasz o {przekroczenie}. Mandat {mandat} złotych, {punkty} punkty. Zwolnij!"
                    
                    if self.aktualne_punkty >= 24 or przekroczenie > 50:
                        komunikat += " Ostrzeżenie! Utrata prawa jazdy!"

                    powiedz(komunikat)
                
                time.sleep(5)

if __name__ == "__main__":
    root = tk.Tk()
    app = PolskaNawigacjaPredkosci(root)
    root.mainloop()
